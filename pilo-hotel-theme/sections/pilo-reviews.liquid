<section class="sec sec--light" id="reviews">
  <div class="wrap">
    <header class="sec__head">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="sec__h">{{ section.settings.heading }}</h2>
    </header>
    <div class="reviews">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            <div class="reviews__app">{% render block %}</div>
          {%- when 'review' -%}
            <figure class="review" {{ block.shopify_attributes }}>
              <div class="stars" aria-label="{{ block.settings.rating }} out of 5 stars">
                {%- for i in (1..block.settings.rating) -%}{% render 'icon', icon: 'star' %}{%- endfor -%}
              </div>
              <blockquote>{{ block.settings.quote }}</blockquote>
              <figcaption>{{ block.settings.author }}{% if block.settings.location != blank %} · {{ block.settings.location }}{% endif %}{% if block.settings.verified %} · <span class="verified">Verified buyer</span>{% endif %}</figcaption>
            </figure>
        {%- endcase -%}
      {%- endfor -%}
    </div>
    {%- if section.blocks.size == 0 -%}
      <p class="empty-note">{{ section.settings.empty_text }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Reviews",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Reviews" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Lebanon is waking up better." },
    { "type": "text", "id": "empty_text", "label": "Text when no reviews", "default": "We've just launched. Be one of the first to review Pilo after your 30 nights." },
    { "type": "paragraph", "content": "Add a reviews app block (e.g. Judge.me or Loox), or add real customer reviews as blocks. Only publish genuine reviews." }
  ],
  "blocks": [
    { "type": "@app" },
    { "type": "review", "name": "Customer review", "settings": [
      { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
      { "type": "textarea", "id": "quote", "label": "Review text" },
      { "type": "text", "id": "author", "label": "Name" },
      { "type": "text", "id": "location", "label": "Area (e.g. Achrafieh)" },
      { "type": "checkbox", "id": "verified", "label": "Verified buyer", "default": true }
    ] }
  ],
  "presets": [{ "name": "Reviews" }]
}
{% endschema %}
