<section class="sec sec--dark" id="layers">
  <div class="wrap layers">
    <div class="layers__art">{% render 'layers-diagram' %}</div>
    <div class="layers__copy">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="sec__h">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div class="sec__sub rte">{{ section.settings.text }}</div>{%- endif -%}
      <ol class="layer-list">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            <span class="layer-list__n">{{ forloop.index }}</span>
            <div><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></div>
          </li>
        {%- endfor -%}
      </ol>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Exploded layers",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Built layer by layer" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Structure you can feel. Support that doesn't quit." },
    { "type": "richtext", "id": "text", "label": "Text" }
  ],
  "blocks": [
    { "type": "layer", "name": "Layer", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Layer" },
      { "type": "textarea", "id": "text", "label": "Text" }
    ] }
  ],
  "presets": [{ "name": "Exploded layers" }]
}
{% endschema %}
