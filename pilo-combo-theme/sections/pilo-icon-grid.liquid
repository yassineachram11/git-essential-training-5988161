<section class="sec sec--{{ section.settings.scheme }}"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor }}"{% endif %}>
  <div class="wrap">
    <header class="sec__head">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="sec__h">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div class="sec__sub rte">{{ section.settings.text }}</div>{%- endif -%}
    </header>
    <div class="cards cards--{{ section.blocks.size | at_most: 4 }}">
      {%- for block in section.blocks -%}
        <article class="card" {{ block.shopify_attributes }}>
          <span class="card__icon">{% render 'icon', icon: block.settings.icon %}</span>
          <h3 class="card__h">{{ block.settings.title }}</h3>
          <div class="card__t rte">{{ block.settings.text }}</div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Icon cards",
  "settings": [
    { "type": "select", "id": "scheme", "label": "Colour scheme", "default": "light", "options": [
      { "value": "light", "label": "Light" }, { "value": "dark", "label": "Dark" }, { "value": "soft", "label": "Soft grey" } ] },
    { "type": "text", "id": "anchor", "label": "Anchor ID" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Icon cards" },
    { "type": "richtext", "id": "text", "label": "Text" }
  ],
  "blocks": [
    { "type": "card", "name": "Card", "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "default": "check", "options": [
        { "value": "check", "label": "Check" }, { "value": "moon", "label": "Moon" }, { "value": "shield", "label": "Shield" },
        { "value": "snow", "label": "Cooling" }, { "value": "wash", "label": "Washable" }, { "value": "spine", "label": "Spine" },
        { "value": "layers", "label": "Layers" }, { "value": "headache", "label": "Headache" }, { "value": "shoulder", "label": "Shoulder" },
        { "value": "truck", "label": "Delivery" }, { "value": "cash", "label": "Cash" } ] },
      { "type": "text", "id": "title", "label": "Title", "default": "Card title" },
      { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Short supporting text.</p>" }
    ] }
  ],
  "presets": [{ "name": "Icon cards", "blocks": [{ "type": "card" }, { "type": "card" }, { "type": "card" }] }]
}
{% endschema %}
