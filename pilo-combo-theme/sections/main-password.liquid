<section class="sec sec--dark banner" style="min-height:100vh;display:grid;place-items:center">
  <div class="wrap banner__inner">
    <span class="wordmark">{{ shop.name }}</span>
    <h1 class="sec__h">{{ section.settings.heading }}</h1>
    {%- form 'storefront_password', class: 'search' -%}
      <label class="visually-hidden" for="pw">Password</label>
      <input id="pw" type="password" name="password" placeholder="Password" autocomplete="current-password">
      <button class="btn btn--accent" type="submit">Enter</button>
      {%- if form.errors -%}<p>{{ form.errors | default_errors }}</p>{%- endif -%}
    {%- endform -%}
  </div>
</section>
{% schema %}
{ "name": "Password", "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Better sleep is coming to Lebanon." }] }
{% endschema %}
