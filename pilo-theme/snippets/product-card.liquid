<a class="pcard" href="{{ product.url }}">
  {%- if product.featured_image -%}{{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: product.title }}{%- endif -%}
  <span class="pcard__t">{{ product.title }}</span>
  <span class="pcard__p">{% if product.price_varies %}From {% endif %}{{ product.price_min | money }}</span>
</a>
