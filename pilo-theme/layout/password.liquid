<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ shop.name }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;800&display=swap" rel="stylesheet">
    <style>:root{--c-ink:{{ settings.color_ink }};--c-paper:{{ settings.color_paper }};--c-accent:{{ settings.color_accent }};--c-accent-ink:{{ settings.color_accent_ink }};--c-alert:{{ settings.color_alert }};--radius:{{ settings.radius }}px;}</style>
    {{ 'pilo.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body>{{ content_for_layout }}</body>
</html>
