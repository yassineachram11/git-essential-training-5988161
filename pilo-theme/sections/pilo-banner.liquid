{%- liquid
  assign url = section.settings.cta_link
  if url == blank and section.settings.product != blank
    assign url = section.settings.product.url
  endif
-%}
<section class="sec sec--{{ section.settings.scheme }} banner">
  <div class="wrap banner__inner">
    {%- if section.settings.icon != 'none' -%}<span class="banner__icon">{% render 'icon', icon: section.settings.icon %}</span>{%- endif -%}
    <h2 class="sec__h">{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<div class="sec__sub rte">{{ section.settings.text }}</div>{%- endif -%}
    {%- if section.settings.cta_label != blank and url != blank -%}
      <a class="btn btn--accent btn--lg" href="{{ url }}">{{ section.settings.cta_label }}</a>
    {%- endif -%}
    {%- if section.settings.fineprint != blank -%}<p class="fineprint">{{ section.settings.fineprint }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Call to action banner",
  "settings": [
    { "type": "select", "id": "scheme", "label": "Colour scheme", "default": "dark", "options": [{ "value": "light", "label": "Light" }, { "value": "dark", "label": "Dark" }, { "value": "soft", "label": "Soft grey" }] },
    { "type": "select", "id": "icon", "label": "Icon", "default": "none", "options": [{ "value": "none", "label": "None" }, { "value": "moon", "label": "Moon" }, { "value": "shield", "label": "Shield" }, { "value": "cash", "label": "Cash" }] },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Tonight could be your last night of waking up stiff." },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Get Pilo · Pay when it arrives" },
    { "type": "url", "id": "cta_link", "label": "Button link (overrides product)" },
    { "type": "text", "id": "fineprint", "label": "Small print" }
  ],
  "presets": [{ "name": "Call to action banner" }]
}
{% endschema %}
