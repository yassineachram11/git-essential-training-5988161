{%- liquid
  assign current_variant = product.selected_or_first_available_variant
-%}

{{ 'product-page.css' | asset_url | stylesheet_tag }}
<script src="{{ 'bundle.js' | asset_url }}" defer="defer"></script>

<section class="section product-page product-page--{{ section.settings.background_style }}">
  <div class="page-width">
    <div class="product">
      {%- comment -%} Gallery {%- endcomment -%}
      <div class="product__media reveal reveal--up" data-gallery>
        <div class="product__media-main">
          {%- if product.featured_media -%}
            <img
              src="{{ product.featured_media | image_url: width: 1200 }}"
              alt="{{ product.featured_media.alt | escape }}"
              width="{{ product.featured_media.width }}"
              height="{{ product.featured_media.height }}"
              loading="eager"
              fetchpriority="high"
              data-gallery-main
            >
          {%- else -%}
            {{ 'product-apparel-1' | placeholder_svg_tag }}
          {%- endif -%}
          {%- render 'gallery-video', product: product -%}
        </div>

        {%- if product.media.size > 1 -%}
          <ul class="product__thumbs" role="list">
            {%- for media in product.media -%}
              <li>
                <button
                  type="button"
                  class="product__thumb{% if forloop.first %} is-active{% endif %}{% if media.media_type == 'video' or media.media_type == 'external_video' %} product__thumb--video{% endif %}"
                  data-gallery-thumb
                  data-media-id="{{ media.id }}"
                  aria-label="{{ 'products.product.view_image' | t: index: forloop.index }}"
                >
                  <img
                    src="{{ media | image_url: width: 200 }}"
                    data-full="{{ media | image_url: width: 1200 }}"
                    alt="{{ media.alt | escape }}"
                    loading="lazy"
                    width="200"
                    height="200"
                  >
                </button>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      {%- comment -%} Buy box {%- endcomment -%}
      <div class="product__info reveal reveal--up" style="--reveal-delay: 100ms;">
        {%- for block in section.blocks -%}
          {%- case block.type -%}

            {%- when 'vendor' -%}
              {%- if product.vendor != blank -%}
                <div class="product__vendor" {{ block.shopify_attributes }}>{{ product.vendor }}</div>
              {%- endif -%}

            {%- when 'title' -%}
              <h1 class="product__title" {{ block.shopify_attributes }}>{{ product.title }}</h1>

            {%- when 'price' -%}
              <div class="product__price" {{ block.shopify_attributes }}>
                {%- render 'price', product: product, variant: current_variant -%}
              </div>

            {%- when 'description' -%}
              {%- if product.description != blank -%}
                <div class="product__description rte" {{ block.shopify_attributes }}>
                  {{ product.description }}
                </div>
              {%- endif -%}

            {%- when 'variant_picker' -%}
              {%- unless product.has_only_default_variant -%}
                <div data-variant-picker {{ block.shopify_attributes }}>
                  {%- for option in product.options_with_values -%}
                    <div class="variant-group">
                      <label class="variant-group__label">
                        {{ option.name }}
                        <span data-option-value="{{ forloop.index }}">— {{ option.selected_value }}</span>
                      </label>
                      <div class="variant-options">
                        {%- for value in option.values -%}
                          {%- assign input_id = 'option-' | append: section.id | append: '-' | append: forloop.parentloop.index | append: '-' | append: forloop.index -%}
                          <div class="variant-option">
                            <input
                              type="radio"
                              id="{{ input_id }}"
                              name="option-{{ forloop.parentloop.index }}"
                              value="{{ value | escape }}"
                              {% if option.selected_value == value %}checked{% endif %}
                            >
                            <label for="{{ input_id }}">{{ value }}</label>
                          </div>
                        {%- endfor -%}
                      </div>
                    </div>
                  {%- endfor -%}

                  <script type="application/json" data-variant-json>
                    [
                      {%- for variant in product.variants -%}
                        {
                          "id": {{ variant.id }},
                          "options": {{ variant.options | json }},
                          "price": {{ variant.price }},
                          "compare_at_price": {{ variant.compare_at_price | default: 0 }},
                          "available": {{ variant.available }}
                        }{% unless forloop.last %},{% endunless %}
                      {%- endfor -%}
                    ]
                  </script>
                </div>
              {%- endunless -%}

            {%- when 'bundle' -%}
              {%- unless product.has_only_default_variant -%}
                {%- liquid
                  comment
                    Two modes. If the section has any bundle_option blocks the
                    merchant controls every row by hand; otherwise the rows are
                    derived from the variant list automatically.
                  endcomment
                  assign manual = false
                  for b in section.blocks
                    if b.type == 'bundle_option'
                      assign manual = true
                      break
                    endif
                  endfor

                  comment
                    Baseline = the highest per-unit price on offer, i.e. the
                    single. Savings are measured against buying that many
                    singles, never against compare-at, which merchants often
                    leave wrong.
                  endcomment
                  assign baseline = 0
                  assign best_per = 0
                  assign best_id = 0
                  if manual
                    for b in section.blocks
                      if b.type == 'bundle_option'
                        assign vi = b.settings.variant_index | minus: 1
                        assign v = product.variants[vi]
                        if v
                          assign u = b.settings.units
                          if u < 1
                            assign u = v.title | split: 'x' | first | times: 1
                          endif
                          if u < 1
                            assign u = 1
                          endif
                          assign per = v.price | divided_by: u
                          if per > baseline
                            assign baseline = per
                          endif
                        endif
                      endif
                    endfor
                  else
                    for v in product.variants
                      assign u = v.title | split: 'x' | first | times: 1
                      if u < 1
                        assign u = 1
                      endif
                      assign per = v.price | divided_by: u
                      if per > baseline
                        assign baseline = per
                      endif
                      comment
                        Track the cheapest pack per unit as well, so only one
                        row can carry the badge. Without this, every pack that
                        saves anything claims to be the best value.
                      endcomment
                      if best_per == 0 or per < best_per
                        assign best_per = per
                        assign best_id = v.id
                      endif
                    endfor
                  endif
                -%}

                <div class="bundle" data-bundle-picker {{ block.shopify_attributes }}>
                  {%- if block.settings.heading != blank -%}
                    <span class="variant-group__label">{{ block.settings.heading }}</span>
                  {%- endif -%}

                  {%- for b in section.blocks -%}
                    {%- liquid
                      if manual
                        unless b.type == 'bundle_option'
                          continue
                        endunless
                        assign vi = b.settings.variant_index | minus: 1
                        assign v = product.variants[vi]
                        unless v
                          continue
                        endunless
                        assign units = b.settings.units
                        assign row_label = b.settings.label
                        assign row_note = b.settings.note
                        assign row_badge = b.settings.badge
                        assign row_override = b.settings.savings_override
                        assign preselect = b.settings.preselect
                        assign attrs = b.shopify_attributes
                      else
                        unless forloop.first
                          continue
                        endunless
                      endif
                    -%}

                    {%- if manual -%}
                      {%- liquid
                        if units < 1
                          assign units = v.title | split: 'x' | first | times: 1
                        endif
                        if units < 1
                          assign units = 1
                        endif
                        assign each = v.price | divided_by: units
                        assign full = baseline | times: units
                        assign save = full | minus: v.price
                        if row_label == blank
                          assign row_label = v.title
                        endif
                        assign selected = false
                        if preselect or v.id == current_variant.id
                          assign selected = true
                        endif
                      -%}
                      {%- render 'bundle-option',
                            variant: v, label: row_label, note: row_note, badge: row_badge,
                            units: units, each: each, save: save, override: row_override,
                            selected: selected, style: block.settings.savings_style,
                            show_unit: block.settings.show_unit_price,
                            section_id: section.id, attrs: attrs -%}
                    {%- else -%}
                      {%- for v in product.variants -%}
                        {%- liquid
                          assign units = v.title | split: 'x' | first | times: 1
                          if units < 1
                            assign units = 1
                          endif
                          assign each = v.price | divided_by: units
                          assign full = baseline | times: units
                          assign save = full | minus: v.price
                          assign row_badge = ''
                          if units > 1 and save > 0 and v.id == best_id
                            assign row_badge = block.settings.badge
                          endif
                          assign selected = false
                          if v.id == current_variant.id
                            assign selected = true
                          endif
                        -%}
                        {%- render 'bundle-option',
                              variant: v, label: v.title, note: '', badge: row_badge,
                              units: units, each: each, save: save, override: '',
                              selected: selected, style: block.settings.savings_style,
                              show_unit: block.settings.show_unit_price,
                              section_id: section.id, attrs: '' -%}
                      {%- endfor -%}
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              {%- endunless -%}

            {%- when 'bundle_option' -%}
              {%- comment -%} Drawn by the bundle block above, not on its own. {%- endcomment -%}

            {%- when 'buy_buttons' -%}
              {%- liquid
                comment
                  Labels fall back to the theme's translations when left empty,
                  so an untouched block keeps rendering exactly as before.
                endcomment
                assign add_label = block.settings.add_label
                if add_label == blank
                  assign add_label = 'products.product.add_to_cart' | t
                endif
                assign sold_label = block.settings.soldout_label
                if sold_label == blank
                  assign sold_label = 'products.product.sold_out' | t
                endif

                assign buy_class = 'product__buy-wrap'
                if block.settings.full_width
                  assign buy_class = buy_class | append: ' product__buy-wrap--full'
                endif

                assign btn_size = 'btn--lg'
                if block.settings.size == 'regular'
                  assign btn_size = ''
                endif
              -%}

              {{ 'buy-buttons.css' | asset_url | stylesheet_tag }}
              {%- if block.settings.show_buy_now -%}
                <script src="{{ 'buy-now.js' | asset_url }}" defer="defer"></script>
              {%- endif -%}
              {%- if block.settings.show_stock -%}
                <script src="{{ 'stock-level.js' | asset_url }}" defer="defer"></script>
              {%- endif -%}

              <div
                class="{{ buy_class }}"
                style="
                  --buy-radius: {{ block.settings.radius }}px;
                  {%- if block.settings.add_bg != blank -%}
                    --buy-add-bg: {{ block.settings.add_bg }};
                    --buy-add-bg-hover: {{ block.settings.add_bg | color_darken: 8 }};
                  {%- endif -%}
                  {%- if block.settings.add_text != blank -%}--buy-add-text: {{ block.settings.add_text }};{%- endif -%}
                  {%- if block.settings.now_bg != blank -%}
                    --buy-now-bg: {{ block.settings.now_bg }};
                    --buy-now-bg-hover: {{ block.settings.now_bg | color_darken: 8 }};
                  {%- endif -%}
                  {%- if block.settings.now_text != blank -%}--buy-now-text: {{ block.settings.now_text }};{%- endif -%}
                "
                {{ block.shopify_attributes }}
              >
                {%- form 'product', product, data-product-form: true -%}
                  <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>

                  {%- if block.settings.show_stock -%}
                    {%- render 'stock-level',
                          product: product,
                          variant: current_variant,
                          threshold: block.settings.stock_threshold,
                          in_label: block.settings.stock_in_label,
                          low_label: block.settings.stock_low_label,
                          out_label: block.settings.stock_out_label,
                          backorder_label: block.settings.stock_backorder_label -%}
                  {%- endif -%}

                  <div class="product__buy">
                    {%- if block.settings.show_quantity -%}
                      <div class="qty">
                        <button type="button" data-qty-change="down" aria-label="{{ 'sections.cart.decrease' | t }}">−</button>
                        <input
                          type="number"
                          name="quantity"
                          value="1"
                          min="1"
                          aria-label="{{ 'sections.cart.quantity' | t }}"
                        >
                        <button type="button" data-qty-change="up" aria-label="{{ 'sections.cart.increase' | t }}">+</button>
                      </div>
                    {%- else -%}
                      <input type="hidden" name="quantity" value="1">
                    {%- endif -%}

                    <button
                      type="submit"
                      class="btn btn--primary btn--add {{ btn_size }}"
                      data-add-to-cart
                      data-buy-anchor
                      {% unless current_variant.available %}disabled{% endunless %}
                    >
                      {%- if current_variant.available -%}
                        {{ add_label }}
                      {%- else -%}
                        {{ sold_label }}
                      {%- endif -%}
                    </button>
                  </div>

                  {%- comment -%}
                    Buy now adds to cart and then goes straight to checkout.
                    Shopify's own dynamic checkout button below cannot be
                    relabelled or recoloured, which is why this exists.
                  {%- endcomment -%}
                  {%- if block.settings.show_buy_now and current_variant.available -%}
                    <button
                      type="button"
                      class="btn btn--buy-now {{ btn_size }}"
                      data-buy-now
                    >
                      {{ block.settings.buy_now_label | default: 'Buy it now' }}
                    </button>
                  {%- endif -%}

                  {%- if block.settings.show_dynamic_checkout -%}
                    <div class="product__checkout-divider"><span>{{ 'products.product.or' | t }}</span></div>
                    {{ form | payment_button }}
                  {%- endif -%}
                {%- endform -%}
              </div>

            {%- when 'trust' -%}
              {%- liquid
                comment
                  Same duality as the bundle: trust_item blocks take over when
                  present, otherwise fall back to the three legacy fields so an
                  existing page keeps rendering unchanged.
                endcomment
                assign has_items = false
                for b in section.blocks
                  if b.type == 'trust_item'
                    assign has_items = true
                    break
                  endif
                endfor

                assign meta_class = 'product__meta'
                if block.settings.layout == 'plain'
                  assign meta_class = meta_class | append: ' product__meta--plain'
                elsif block.settings.layout == 'grid'
                  assign meta_class = meta_class | append: ' product__meta--grid'
                endif
                if block.settings.icon_style == 'plain'
                  assign meta_class = meta_class | append: ' product__meta--icons-plain'
                endif
              -%}

              {%- if block.settings.heading != blank -%}
                <div class="product__meta-heading">{{ block.settings.heading }}</div>
              {%- endif -%}

              <div class="{{ meta_class }}" {{ block.shopify_attributes }}>
                {%- if has_items -%}
                  {%- for b in section.blocks -%}
                    {%- if b.type == 'trust_item' -%}
                      {%- render 'trust-item',
                            icon: b.settings.icon,
                            text: b.settings.text,
                            note: b.settings.note,
                            attrs: b.shopify_attributes -%}
                    {%- endif -%}
                  {%- endfor -%}
                {%- else -%}
                  {%- render 'trust-item', icon: 'truck', text: block.settings.item_1, note: '', attrs: '' -%}
                  {%- render 'trust-item', icon: 'refresh', text: block.settings.item_2, note: '', attrs: '' -%}
                  {%- render 'trust-item', icon: 'shield', text: block.settings.item_3, note: '', attrs: '' -%}
                {%- endif -%}
              </div>

            {%- when 'trust_item' -%}
              {%- comment -%} Drawn by the trust block above, not on its own. {%- endcomment -%}

            {%- when 'collapsible' -%}
              <div class="accordion" style="margin-top: var(--space-lg);" {{ block.shopify_attributes }}>
                <div class="accordion__item">
                  <button type="button" class="accordion__toggle" data-toggle aria-expanded="false">
                    {{ block.settings.heading }}
                    {%- render 'icon', name: 'chevron-down' -%}
                  </button>
                  <div class="accordion__panel">
                    <div>
                      <div class="accordion__panel-inner rte">{{ block.settings.content }}</div>
                    </div>
                  </div>
                </div>
              </div>

            {%- when '@app' -%}
              {% render block %}

          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{%- if section.settings.show_buy_bar -%}
  <div class="buy-bar" data-buy-bar aria-hidden="true">
    {%- if product.featured_media -%}
      {{
        product.featured_media.preview_image
        | image_url: width: 120
        | image_tag: loading: 'lazy', class: 'buy-bar__thumb', alt: ''
      }}
    {%- endif -%}

    <div class="buy-bar__info">
      <div class="buy-bar__title">{{ product.title | escape }}</div>
      <div class="buy-bar__price" data-buy-bar-price>
        {%- if current_variant.compare_at_price > current_variant.price -%}
          {{ current_variant.price | money }}
          <s class="price__compare">{{ current_variant.compare_at_price | money }}</s>
        {%- else -%}
          {{ current_variant.price | money }}
        {%- endif -%}
      </div>
    </div>

    <button type="button" class="btn btn--primary" data-buy-bar-add>
      {{ 'products.product.add_to_cart' | t }}
    </button>
  </div>
{%- endif -%}

{%- comment -%} Structured data for rich results {%- endcomment -%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org/",
    "@type": "Product",
    "name": {{ product.title | json }},
    "url": {{ shop.url | append: product.url | json }},
    {% if product.featured_media -%}
      "image": [{{ product.featured_media | image_url: width: 1200 | prepend: 'https:' | json }}],
    {%- endif %}
    "description": {{ product.description | strip_html | json }},
    {% if product.selected_or_first_available_variant.sku != blank -%}
      "sku": {{ product.selected_or_first_available_variant.sku | json }},
    {%- endif %}
    "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
    "offers": {
      "@type": "Offer",
      "price": {{ current_variant.price | divided_by: 100.0 | json }},
      "priceCurrency": {{ cart.currency.iso_code | json }},
      "availability": "https://schema.org/{% if current_variant.available %}InStock{% else %}OutOfStock{% endif %}",
      "url": {{ shop.url | append: product.url | json }}
    }
  }
</script>

{% schema %}
{
  "name": "Product information",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_buy_bar",
      "label": "Sticky add to cart bar",
      "info": "Slides up once the main buy button scrolls out of view.",
      "default": true
    },
    {
      "type": "select",
      "id": "background_style",
      "label": "Page background",
      "options": [
        { "value": "none", "label": "White" },
        { "value": "gradient", "label": "Soft blue wash" },
        { "value": "tint", "label": "Flat surface" }
      ],
      "default": "gradient"
    }
  ],
  "blocks": [
    { "type": "vendor", "name": "Vendor", "limit": 1 },
    { "type": "title", "name": "Title", "limit": 1 },
    { "type": "price", "name": "Price", "limit": 1 },
    { "type": "variant_picker", "name": "Variant picker", "limit": 1 },
    {
      "type": "bundle",
      "name": "Bundle selector",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Choose your pack" },
        {
          "type": "select",
          "id": "savings_style",
          "label": "Show savings as",
          "options": [
            { "value": "amount", "label": "Amount saved" },
            { "value": "percent", "label": "Percent saved" },
            { "value": "none", "label": "Don't show savings" }
          ],
          "default": "amount"
        },
        {
          "type": "checkbox",
          "id": "show_unit_price",
          "label": "Show per-unit price on multi-packs",
          "default": true
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Automatic badge",
          "default": "Best value",
          "info": "Goes on the pack with the lowest price per pillow. Only used when you have not added Pack option blocks below."
        },
        {
          "type": "paragraph",
          "content": "With no Pack option blocks, rows are generated from your variants and savings are read from names like '2x Bundle'. Add Pack option blocks to control every row by hand. Use this instead of the variant picker, not alongside it."
        }
      ]
    },
    {
      "type": "bundle_option",
      "name": "Pack option",
      "settings": [
        {
          "type": "range",
          "id": "variant_index",
          "label": "Variant",
          "min": 1,
          "max": 12,
          "step": 1,
          "default": 1,
          "info": "Which variant this row sells, counting from the top of your variant list."
        },
        { "type": "text", "id": "label", "label": "Label", "info": "Leave blank to use the variant name." },
        { "type": "text", "id": "note", "label": "Small note", "info": "Replaces the per-unit price on this row." },
        { "type": "text", "id": "badge", "label": "Badge" },
        {
          "type": "range",
          "id": "units",
          "label": "Units in this pack",
          "min": 0,
          "max": 12,
          "step": 1,
          "default": 0,
          "info": "0 reads the number from the variant name. Used for per-unit and savings maths."
        },
        { "type": "text", "id": "savings_override", "label": "Savings text override" },
        { "type": "checkbox", "id": "preselect", "label": "Selected by default", "default": false }
      ]
    },
    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_quantity", "label": "Show quantity selector", "default": true },
        { "type": "header", "content": "Stock level" },
        {
          "type": "checkbox",
          "id": "show_stock",
          "label": "Show a stock line above the quantity selector",
          "default": true,
          "info": "Only ever says what Shopify already knows. Variants with inventory tracking turned off can only show the in-stock wording."
        },
        {
          "type": "range",
          "id": "stock_threshold",
          "label": "Call it low stock at or below",
          "min": 1,
          "max": 50,
          "step": 1,
          "unit": "pcs",
          "default": 10
        },
        { "type": "text", "id": "stock_in_label", "label": "In stock wording", "default": "In stock, ready to ship" },
        {
          "type": "text",
          "id": "stock_low_label",
          "label": "Low stock wording",
          "default": "Only [count] left",
          "info": "[count] is replaced by the number remaining. Leave it out to keep the number private."
        },
        { "type": "text", "id": "stock_out_label", "label": "Out of stock wording", "default": "Out of stock" },
        {
          "type": "text",
          "id": "stock_backorder_label",
          "label": "Backorder wording",
          "default": "Available on backorder",
          "info": "Used when a variant is sold out but set to keep selling."
        },
        { "type": "header", "content": "Labels" },
        {
          "type": "text",
          "id": "add_label",
          "label": "Add to cart label",
          "info": "Leave empty to use the theme's wording."
        },
        {
          "type": "text",
          "id": "soldout_label",
          "label": "Sold out label",
          "info": "Leave empty to use the theme's wording."
        },
        { "type": "header", "content": "Buy now" },
        {
          "type": "checkbox",
          "id": "show_buy_now",
          "label": "Show a Buy now button",
          "default": false,
          "info": "Adds to the cart and goes straight to checkout."
        },
        { "type": "text", "id": "buy_now_label", "label": "Buy now label", "default": "Buy it now" },
        {
          "type": "checkbox",
          "id": "show_dynamic_checkout",
          "label": "Show Shopify's dynamic checkout button",
          "default": true,
          "info": "Shop Pay, PayPal and so on. Shopify controls its wording and colour — use the Buy now button above if you need those to match your brand."
        },
        { "type": "header", "content": "Appearance" },
        {
          "type": "select",
          "id": "size",
          "label": "Button size",
          "options": [
            { "value": "large", "label": "Large" },
            { "value": "regular", "label": "Regular" }
          ],
          "default": "large"
        },
        {
          "type": "checkbox",
          "id": "full_width",
          "label": "Full width",
          "default": false,
