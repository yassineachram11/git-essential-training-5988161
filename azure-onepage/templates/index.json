    "designed": {
      "type": "rich-text",
      "settings": {
        "eyebrow": "Protect your neck",
        "heading": "Designed for your neck.",
        "text": "<p>Experience perfect alignment with adaptive contour foam that relieves neck tension. Wrapped in a breathable cooling cover, the Pilo 1.0 keeps you comfortable and supported all night long. Free delivery across Lebanon, and you can pay cash on delivery.</p>",
        "button_label": "Choose your pack",
        "button_link": "/#buy"
      }
