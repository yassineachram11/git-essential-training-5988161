<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_primary }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {%- render 'meta-tags' -%}

    {{ content_for_header }}

    {%- liquid
      assign body_font = settings.font_body
      assign heading_font = settings.font_heading
      assign body_font_bold = body_font | font_modify: 'weight', 'bold'
      assign body_font_italic = body_font | font_modify: 'style', 'italic'
    -%}

    {{ 'base.css' | asset_url | stylesheet_tag }}

    <style>
      {%- comment -%}
        font_face emits raw @font-face rules, so these must stay inside <style>.
      {%- endcomment -%}
      {{ body_font | font_face: font_display: 'swap' }}
      {{ body_font_bold | font_face: font_display: 'swap' }}
      {{ body_font_italic | font_face: font_display: 'swap' }}
      {{ heading_font | font_face: font_display: 'swap' }}

      {%- liquid
        case settings.animation_speed
          when 'fast'
            assign d_fast = '100ms'
            assign d_base = '180ms'
            assign d_slow = '320ms'
          when 'relaxed'
            assign d_fast = '200ms'
            assign d_base = '350ms'
            assign d_slow = '600ms'
          else
            assign d_fast = '150ms'
            assign d_base = '250ms'
            assign d_slow = '450ms'
        endcase
      -%}
      :root {
        --color-primary: {{ settings.color_primary }};
        --color-primary-hover: {{ settings.color_primary_hover }};
        --color-primary-soft: {{ settings.color_primary_soft }};
        --color-primary-rgb: {{ settings.color_primary.red }}, {{ settings.color_primary.green }}, {{ settings.color_primary.blue }};

        --color-text: {{ settings.color_text }};
        --color-text-muted: {{ settings.color_text_muted }};
        --color-background: {{ settings.color_background }};
        --color-surface: {{ settings.color_surface }};
        --color-border: {{ settings.color_border }};
        --color-border-strong: {{ settings.color_border | color_darken: 10 }};
        --color-sale: {{ settings.color_sale }};

        --font-body: {{ body_font.family }}, {{ body_font.fallback_families }};
        --font-heading: {{ heading_font.family }}, {{ heading_font.fallback_families }};
        --font-body-weight: {{ body_font.weight }};
        --font-heading-weight: {{ heading_font.weight }};
        --font-base-size: {{ settings.body_scale }}px;
        --font-heading-scale: {{ settings.heading_scale | divided_by: 100.0 }};
        --letter-spacing-heading: {{ settings.heading_letter_spacing }};

        --page-width: {{ settings.page_width }}px;
        --section-padding-block: {{ settings.section_spacing }}px;

        --radius-button: {{ settings.radius_button }}px;
        --radius-lg: {{ settings.radius_card }}px;
        --radius-xl: {{ settings.radius_card | plus: 8 }}px;
        --card-aspect-ratio: {{ settings.card_image_ratio }};

        --duration-fast: {{ d_fast }};
        --duration-base: {{ d_base }};
        --duration-slow: {{ d_slow }};
      }

      {%- if settings.heading_uppercase -%}
        h1, h2, h3, h4, h5, h6 { text-transform: uppercase; }
      {%- endif -%}

      {%- unless settings.animations_reveal -%}
        .reveal { opacity: 1 !important; transform: none !important; }
      {%- endunless -%}

      {%- unless settings.animations_hover -%}
        .card:hover, .btn:hover, .feature-card:hover, .testimonial:hover, .social-list a:hover {
          transform: none !important;
        }
      {%- endunless -%}

      {%- unless settings.animations_image_zoom -%}
        .card:hover .card__image,
        .collection-card:hover img,
        .article-card:hover .article-card__image img { transform: none !important; }
      {%- endunless -%}
    </style>

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      window.Shopify = window.Shopify || {};
      window.Shopify.routes = window.Shopify.routes || {};
      window.Shopify.routes.root = {{ routes.root_url | append: '/' | replace: '//', '/' | json }};
      window.AzureTheme = {
        moneyFormat: {{ shop.money_format | json }},
        cartType: {{ settings.cart_type | json }},
        strings: {
          addToCart: {{ 'products.product.add_to_cart' | t | json }},
          soldOut: {{ 'products.product.sold_out' | t | json }},
          unavailable: {{ 'products.product.unavailable' | t | json }}
        }
      };
    </script>

    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
  </head>

  <body class="template-{{ template.name | handle }}">
    <a class="skip-to-content" href="#MainContent">{{ 'accessibility.skip_to_text' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- if settings.cart_type == 'drawer' -%}
      {% section 'cart-drawer' %}
    {%- endif -%}

    <div class="overlay" data-overlay aria-hidden="true"></div>

    <ul hidden>
      <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t }}</li>
    </ul>
  </body>
</html>
