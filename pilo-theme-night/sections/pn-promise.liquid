{{ 'pilo-night.css' | asset_url | stylesheet_tag }}
<script src="{{ 'pilo-night.js' | asset_url }}" defer="defer"></script>

<section class="pn pn-promise pn__pad">
  <div class="pn__wrap">
    <div class="pn-moments__head" style="color: var(--pn-on-night);">
      {%- if section.settings.eyebrow != blank -%}<span class="pn-eyebrow" data-pn-reveal>{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="pn-h2" data-pn-words>{{ section.settings.heading }}</h2>
    </div>

    <div class="pn-promise__grid">
      {%- for block in section.blocks limit: 4 -%}
        <div class="pn-promise__item" data-pn-reveal style="--d: {{ forloop.index0 | times: 110 }}ms;" {{ block.shopify_attributes }}>
          <span class="pn-promise__big">
            {%- if block.settings.number != blank -%}
              <span data-pn-count="{{ block.settings.number }}" data-prefix="{{ block.settings.prefix }}">{{ block.settings.prefix }}{{ block.settings.number }}</span>{{ block.settings.suffix }}
            {%- else -%}
              {{ block.settings.big }}
            {%- endif -%}
          </span>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>

    <div class="pn-promise__cta" data-pn-reveal>
      <a class="pn-btn pn-btn--moon" href="#buy">{{ section.settings.button_label }}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
      {%- if section.settings.whatsapp != blank -%}
        <a class="pn-btn pn-btn--wa" href="https://wa.me/{{ section.settings.whatsapp | remove: '+' | remove: ' ' | remove: '-' }}?text={{ 'Hi Pilo! I have a question about the pillow.' | url_encode }}" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.1-1.2l-.5-.3Z"/></svg>
          {{ section.settings.whatsapp_label }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Pilo · Promise",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Zero risk to order" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "You pay <em>only</em> when it's in your hands." },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Choose your pack" },
    { "type": "text", "id": "whatsapp", "label": "WhatsApp number", "default": "+961 78 953 771" },
    { "type": "text", "id": "whatsapp_label", "label": "WhatsApp button", "default": "Ask us on WhatsApp" }
  ],
  "blocks": [
    { "type": "item", "name": "Promise", "settings": [
      { "type": "text", "id": "prefix", "label": "Before the number", "info": "e.g. $" },
      { "type": "text", "id": "number", "label": "Number (counts up)", "info": "Leave empty to use the big text instead." },
      { "type": "text", "id": "suffix", "label": "After the number" },
      { "type": "text", "id": "big", "label": "Big text" },
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "text", "id": "text", "label": "Text" }
    ] }
  ],
  "presets": [{ "name": "Pilo · Promise" }]
}
{% endschema %}
