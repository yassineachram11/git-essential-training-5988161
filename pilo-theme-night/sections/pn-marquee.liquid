{{ 'pilo-night.css' | asset_url | stylesheet_tag }}

<div class="pn pn-marquee" style="--speed: {{ section.settings.speed }}s;">
  <p class="visually-hidden" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);">
    {%- for block in section.blocks -%}{{ block.settings.text }}{% unless forloop.last %} · {% endunless %}{%- endfor -%}
  </p>
  <div class="pn-marquee__track" aria-hidden="true">
    {%- for copy in (1..2) -%}
      <div class="pn-marquee__group">
        {%- for round in (1..2) -%}
          {%- for block in section.blocks -%}
            <span class="pn-marquee__item" {% if copy == 1 and round == 1 %}{{ block.shopify_attributes }}{% endif %}>{{ block.settings.text }}</span>
          {%- endfor -%}
        {%- endfor -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Pilo · Ticker",
  "tag": "div",
  "settings": [
    { "type": "range", "id": "speed", "label": "Seconds per loop", "min": 12, "max": 80, "step": 2, "default": 36 }
  ],
  "blocks": [
    { "type": "item", "name": "Item", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Free delivery across Lebanon" } ] }
  ],
  "presets": [{
    "name": "Pilo · Ticker",
    "blocks": [
      { "type": "item", "settings": { "text": "Free delivery across Lebanon" } },
      { "type": "item", "settings": { "text": "Pay cash when it arrives" } },
      { "type": "item", "settings": { "text": "OEKO-TEX® certified fabric" } },
      { "type": "item", "settings": { "text": "Cover zips off and machine washes" } }
    ]
  }]
}
{% endschema %}
