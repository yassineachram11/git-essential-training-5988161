{{ 'pilo-night.css' | asset_url | stylesheet_tag }}
<script src="{{ 'pilo-night.js' | asset_url }}" defer="defer"></script>

<section class="pn pn--night pn-final pn__pad" data-pn-track="pass">
  <div class="pn-stars" aria-hidden="true"></div>
  <div class="pn-final__moon" aria-hidden="true"></div>
  <div class="pn__wrap pn-final__inner">
    {%- if section.settings.image != blank -%}
      <div class="pn-final__pillow" aria-hidden="true">
        {{ section.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 750px) 420px, 80vw', alt: '' }}
      </div>
    {%- endif -%}
    {%- if section.settings.eyebrow != blank -%}<span class="pn-eyebrow" data-pn-reveal>{{ section.settings.eyebrow }}</span>{%- endif -%}
    <h2 class="pn-display" data-pn-words>{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<p class="pn-lead" data-pn-reveal style="--d: 300ms; margin-inline: auto;">{{ section.settings.text }}</p>{%- endif -%}
    <a class="pn-btn pn-btn--moon" href="#buy" data-pn-reveal style="--d: 420ms;">{{ section.settings.button_label }}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
    </a>
    {%- if section.settings.small != blank -%}<p class="pn-final__small" data-pn-reveal style="--d: 500ms;">{{ section.settings.small }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Pilo · Final call",
  "tag": "div",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Pillow (transparent PNG)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Tonight" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Tonight could feel <em>different.</em>" },
    { "type": "text", "id": "text", "label": "Text", "default": "Order now and it's at your door in 1–5 days. Free delivery, and you pay cash when it arrives." },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Choose your pack" },
    { "type": "text", "id": "small", "label": "Small print", "default": "Questions first? We answer on WhatsApp every day." }
  ],
  "presets": [{ "name": "Pilo · Final call" }]
}
{% endschema %}
