<section class="sec sec--light" id="faq">
  <div class="wrap wrap--narrow">
    <header class="sec__head">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="sec__h">{{ section.settings.heading }}</h2>
    </header>
    {%- for block in section.blocks -%}
      {%- if block.type == 'group' -%}
        <h3 class="faq__group" {{ block.shopify_attributes }}>{{ block.settings.title }}</h3>
      {%- else -%}
        <details class="faq" {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question }}<span class="faq__plus">{% render 'icon', icon: 'plus' %}</span></summary>
          <div class="faq__a rte">{{ block.settings.answer }}</div>
        </details>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- assign first = true -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'question' -%}
        {%- unless first %},{% endunless -%}
        {"@type": "Question", "name": {{ block.settings.question | json }}, "acceptedAnswer": {"@type": "Answer", "text": {{ block.settings.answer | strip_html | json }}}}
        {%- assign first = false -%}
      {%- endif -%}
    {%- endfor -%}
  ]
}
</script>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "FAQ" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions, answered honestly." }
  ],
  "blocks": [
    { "type": "group", "name": "Group heading", "settings": [{ "type": "text", "id": "title", "label": "Title", "default": "Product" }] },
    { "type": "question", "name": "Question", "settings": [
      { "type": "text", "id": "question", "label": "Question", "default": "Question" },
      { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Answer</p>" }
    ] }
  ],
  "presets": [{ "name": "FAQ" }]
}
{% endschema %}
