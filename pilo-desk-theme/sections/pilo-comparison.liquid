<section class="sec sec--soft">
  <div class="wrap">
    <header class="sec__head">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="sec__h">{{ section.settings.heading }}</h2>
    </header>
    <div class="cmp-wrap">
      <table class="cmp">
        <thead>
          <tr>
            <th scope="col"><span class="visually-hidden">Feature</span></th>
            <th scope="col" class="cmp__us">{{ section.settings.col_1 }}</th>
            <th scope="col">{{ section.settings.col_2 }}</th>
            <th scope="col">{{ section.settings.col_3 }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <th scope="row">{{ block.settings.feature }}</th>
              {%- assign vals = block.settings.us | append: ',' | append: block.settings.b | append: ',' | append: block.settings.c | split: ',' -%}
              {%- for v in vals -%}
                <td{% if forloop.first %} class="cmp__us"{% endif %}>
                  {%- if v == 'yes' -%}<span class="cmp__y">{% render 'icon', icon: 'check' %}<span class="visually-hidden">Yes</span></span>
                  {%- elsif v == 'no' -%}<span class="cmp__n">{% render 'icon', icon: 'x' %}<span class="visually-hidden">No</span></span>
                  {%- else -%}<span class="cmp__p">Partly</span>{%- endif -%}
                </td>
              {%- endfor -%}
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Comparison table",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Compare" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Not all pillows are built to support." },
    { "type": "text", "id": "col_1", "label": "Column 1 (you)", "default": "Pilo" },
    { "type": "text", "id": "col_2", "label": "Column 2", "default": "Standard pillow" },
    { "type": "text", "id": "col_3", "label": "Column 3", "default": "Feather pillow" }
  ],
  "blocks": [
    { "type": "row", "name": "Row", "settings": [
      { "type": "text", "id": "feature", "label": "Feature", "default": "Feature" },
      { "type": "select", "id": "us", "label": "Column 1", "default": "yes", "options": [{ "value": "yes", "label": "Yes" }, { "value": "no", "label": "No" }, { "value": "partial", "label": "Partly" }] },
      { "type": "select", "id": "b", "label": "Column 2", "default": "no", "options": [{ "value": "yes", "label": "Yes" }, { "value": "no", "label": "No" }, { "value": "partial", "label": "Partly" }] },
      { "type": "select", "id": "c", "label": "Column 3", "default": "no", "options": [{ "value": "yes", "label": "Yes" }, { "value": "no", "label": "No" }, { "value": "partial", "label": "Partly" }] }
    ] }
  ],
  "presets": [{ "name": "Comparison table" }]
}
{% endschema %}
