    "faq_LiwbDR": {
      "type": "faq",
      "blocks": {
        "q_cod": {
          "type": "question",
          "settings": {
            "question": "How can I pay?",
            "answer": "<p>No card needed: you pay the courier in <strong>cash on delivery</strong> when your Pilo arrives.</p>"
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "How long does delivery take, and what does it cost?",
            "answer": "<p>Delivery is free anywhere in Lebanon. We confirm every order by message or email, then send it out — it reaches you in 1–5 days depending on where you are.</p>"
          }
        },
        "q1": {
          "type": "question",
          "settings": {
            "question": "What is the return policy?",
            "answer": "<p>Because a pillow rests against your face all night, we can only take back packs that are still sealed and unopened — the same rule any hygiene product follows. What protects you is that you pay nothing in advance: the courier takes the cash only once the box is in your hands. If what arrives is damaged or is not what you ordered, message us on WhatsApp and we will replace it.</p>"
          }
        },
        "q_position": {
          "type": "question",
          "settings": {
            "question": "Which sleeping positions is it for?",
            "answer": "<p>Back and side sleepers.</p>"
          }
        },
        "q_adjust": {
          "type": "question",
          "settings": {
            "question": "Is it normal for it to feel different at first?",
            "answer": "<p>Yes. A contour pillow holds your neck in a position it may not be used to. The first two or three nights can feel unfamiliar; most people settle in within a week.</p>"
          }
        },
        "q_made": {
          "type": "question",
          "settings": {
            "question": "What is Pilo made of?",
            "answer": "<p>An <strong>adaptive contour memory foam</strong> core inside a <strong>breathable cooling cover</strong> that zips off. The fabric is <strong>OEKO-TEX® STANDARD 100</strong> certified.</p>"
          }
        },
        "q_size": {
          "type": "question",
          "settings": {
            "question": "How big is it?",
            "answer": "<p>61 × 41 × 10 cm and 1.1 kg.</p>"
          }
        },
        "q_wash": {
          "type": "question",
          "settings": {
            "question": "How do I wash it?",
            "answer": "<p>Unzip the cover and put it in the washing machine. The foam core itself should not be washed.</p>"
          }
        },
        "question_tB3gYX": {
          "type": "question",
          "settings": {
            "question": "What does OEKO-TEX® certified mean?",
            "answer": "<p>OEKO-TEX® STANDARD 100 is an independent certification for textiles. Every component of a certified item is laboratory tested against a long list of substances known to be harmful to human health — not only the main fabric, but the threads, the zip, and any coatings or prints.</p>"
          }
        }
      },
