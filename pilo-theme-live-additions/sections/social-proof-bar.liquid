{%- comment -%}
  Social proof bar: a slim strip with a real order count, plus (optionally)
  a highlight on the first line of the product's "Key benefits" list, so the
  same number also stands out right above the price.
  Keep the number true: round down and update it as orders grow.
{%- endcomment -%}
{%- if section.settings.text != blank -%}
<style>
  #spb-{{ section.id }} {
    background: {{ section.settings.background }};
    color: {{ section.settings.text_color }};
    text-align: center;
    padding: 10px 16px;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: .01em;
    line-height: 1.35;
  }
  #spb-{{ section.id }} .spb__star { color: {{ section.settings.accent }}; margin-right: 6px; }
  #spb-{{ section.id }} .spb__sub { font-weight: 500; opacity: .85; }
  @media (max-width: 480px) { #spb-{{ section.id }} { font-size: 14px; } }

  {%- if section.settings.highlight_benefit -%}
  .product__benefits li:first-child {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    padding: 9px 14px 9px 10px;
    border-radius: 999px;
    background: {{ section.settings.badge_background }};
    color: {{ section.settings.badge_text }};
    font-weight: 700;
    box-shadow: 0 6px 16px rgba(0, 0, 0, .08);
  }
  .product__benefits li:first-child svg {
    background: {{ section.settings.badge_text }} !important;
    color: {{ section.settings.badge_background }} !important;
  }
  {%- endif -%}
</style>

<div id="spb-{{ section.id }}" class="spb" role="note">
  <span class="spb__star" aria-hidden="true">★</span>{{ section.settings.text }}
  {%- if section.settings.subtext != blank -%}<span class="spb__sub"> · {{ section.settings.subtext }}</span>{%- endif -%}
</div>
{%- endif -%}

{% schema %}
{
  "name": "Social proof bar",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "30+ Pilo pillows ordered across Lebanon", "info": "Use your real count, rounded down." },
    { "type": "text", "id": "subtext", "label": "Small text after it", "default": "Free delivery · Cash on delivery" },
    { "type": "color", "id": "background", "label": "Bar background", "default": "#35608f" },
    { "type": "color", "id": "text_color", "label": "Bar text", "default": "#ffffff" },
    { "type": "color", "id": "accent", "label": "Star colour", "default": "#f5c451" },
    { "type": "header", "content": "Product page badge" },
    { "type": "checkbox", "id": "highlight_benefit", "label": "Highlight the first 'Key benefits' line as a badge", "default": true },
    { "type": "color", "id": "badge_background", "label": "Badge background", "default": "#e8f5ee" },
    { "type": "color", "id": "badge_text", "label": "Badge text", "default": "#12805c" }
  ],
  "presets": [{ "name": "Social proof bar" }]
}
{% endschema %}
